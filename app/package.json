{
  "name": "canta-ao-contrario-app",
  "version": "1.0.0",
  "private": true,
  "description": "App Android e iPhone do Canta ao Contrário (Capacitor)",
  "scripts": {
    "build:web": "node scripts/copy-web.mjs",
    "sync": "npm run build:web && cap sync",
    "assets": "capacitor-assets generate --assetPath ../resources --iconBackgroundColor \"#FF5B2E\" --iconBackgroundColorDark \"#FF5B2E\" --splashBackgroundColor \"#170A05\" --splashBackgroundColorDark \"#170A05\"",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3"
  }
}
